# Copy to .env and edit on the head Spark only.

# SSH orchestration uses the management address. This may be a hostname,
# user@hostname, or an address; the documentation-only value is RFC 5737.
WORKER_HOST=dgx-spark-worker.example.net

# RoCE fabric addresses used for Torch rendezvous and vLLM transport.
MASTER_ADDR=192.0.2.10
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=192.0.2.10
WORKER_VLLM_HOST_IP=192.0.2.11

# Change these to the ConnectX port facing the other Spark on each node.
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
WORKER_NCCL_IB_HCA=rocep1s0f0
WORKER_NCCL_SOCKET_IFNAME=enp1s0f0np0
WORKER_TP_SOCKET_IFNAME=enp1s0f0np0
WORKER_GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_AUTO=1
NCCL_CROSS_NIC=1

# The launch script mirrors its runtime directory on the worker by default.
# Set these only if the worker uses different paths.
WORKER_DIR=
WORKER_SCRIPT_DIR=

# Model and JIT caches. Use separate local caches unless NFS is intentional.
HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
DSPARK_WORKER_HF_NFS=0
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Immutable runtime image used by the qualified pair.
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# OpenAI-compatible endpoint on the head node.
VLLM_HOST=0.0.0.0
VLLM_PORT=8888

# Live-qualified 1M agent profile.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=2
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096
GPU_MEMORY_UTILIZATION_TEXT=0.835
MTP_NUM_TOKENS=5
DEFAULT_THINKING=max

# Reliability and compatibility switches used by the qualified deployment.
DSPARK_ISSUE43_SCHED_DIAG=0
DSPARK_ENABLE_ASSISTANT_FINAL_HOTFIX=1
DSPARK_ENABLE_ISSUE138_RESPONSES_HISTORY_COMPAT=0
DSPARK_ENABLE_CODEX_AGENT_MESSAGE_COMPAT=0
DSPARK_ENABLE_ISSUE136_XGRAMMAR_HOTFIX=0
DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=0
DSPARK_ENABLE_ISSUE141_SPARSE_MLA_CHUNK=0
DSPARK_ENABLE_SP_INDEXER=0
DSPARK_ENABLE_REPLICATE_MARKOV=0
DSPARK_ENABLE_ADAPTIVE_CHUNK=0
DSPARK_ENABLE_DEEPGEMM_SM121_ALIAS=0

# GB10 / sm_121 runtime profile.
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Optional vLLM API authentication. Prefer exporting this only for start, or
# storing it in a protected file. Never commit a real key.
# VLLM_API_KEY=
